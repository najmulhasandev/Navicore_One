# Public URL of this site (canonicals, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://os.navicore.co
# Main company site, used in Organization JSON-LD.   [TODO: confirm with founder] www or non-www?
NEXT_PUBLIC_ORG_URL=https://www.navicore.co

# Where contact/partner form submissions are POSTed as JSON (e.g. a Zapier catch hook, or your CRM).
# If unset, production shows a friendly "temporarily unavailable" message instead of silently dropping leads.
# [TODO: confirm with founder] where should leads go?
LEAD_WEBHOOK_URL=

# Optional bot protection (Cloudflare Turnstile). Leave both empty to disable.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Set to 1 to show [TODO: confirm with founder] markers in the page (always shown in `next dev`).
SHOW_TODOS=

# Optional: Google Search Console HTML-tag verification token.
GOOGLE_SITE_VERIFICATION=
